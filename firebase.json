{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "*.md", "**/.*"],
    "headers": [
      { "source": "**/*.@(js|css|html|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
