rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SADECE bu iki Google hesabı okuyup yazabilir.
    // E-postaları config.js'teki "members" ile AYNI yazın (küçük harf).
    function isCouple() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'mchtcldr@gmail.com',
          'egrsl113@gmail.com'
        ];
    }

    // Giriş yapan kişinin config.js'teki anahtarı (ilk e-posta = 'a')
    function myKey() {
      return request.auth.token.email == 'mchtcldr@gmail.com' ? 'a' : 'b';
    }

    function str(v, max) { return v is string && v.size() <= max; }

    // Görevler
    match /tasks/{id} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && str(request.resource.data.title, 200) && request.resource.data.title.size() > 0
        && request.resource.data.owner in ['a', 'b', 'both']
        && request.resource.data.done is bool;
    }

    // Market listesi
    match /shopping/{id} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && str(request.resource.data.name, 120) && request.resource.data.name.size() > 0
        && request.resource.data.urgent is bool
        && request.resource.data.bought is bool;
    }

    // Sohbet mesajları
    match /messages/{id} {
      allow read, delete: if isCouple();
      allow create: if isCouple()
        && str(request.resource.data.text, 6000)
        && request.resource.data.from in ['a', 'b'];
    }

    // Takvim işaretleri (nöbet / etkinlik) — id: YYYY-MM-DD_a
    match /marks/{id} {
      allow read, write: if isCouple();
    }

    // Ortak ayarlar (isimler)
    match /settings/{id} {
      allow read, write: if isCouple();
    }

    // Döngü (regl) takibi — kayıtları sadece sahibi yazar; eş yalnızca
    // sahibi cycleSettings/{owner}.share = true yaptıysa okuyabilir.
    match /cycleSettings/{owner} {
      allow read: if isCouple();
      allow write: if isCouple() && myKey() == owner;
    }
    match /cycle/{owner}/days/{date} {
      allow read: if isCouple() && (myKey() == owner
        || get(/databases/$(database)/documents/cycleSettings/$(owner)).data.get('share', false) == true);
      allow write: if isCouple() && myKey() == owner;
    }

    // Pano: izlenecekler / istek listesi / tatil hayalleri
    match /board/{id} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && str(request.resource.data.title, 200) && request.resource.data.title.size() > 0
        && request.resource.data.type in ['watch', 'wish', 'trip'];
    }

    // Bütçe / harcamalar
    match /expenses/{id} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount < 100000000
        && request.resource.data.paidBy in ['a', 'b']
        && request.resource.data.split in ['a', 'b', 'both'];
    }

    // Bildirim cihaz anahtarları (sunucu okur; uygulama sadece kendi anahtarını yazar)
    match /pushTokens/{token} {
      allow create, update: if isCouple() && request.resource.data.owner == myKey();
      allow delete: if isCouple();
    }

    // Kişisel bildirim tercihleri
    match /notifyPrefs/{owner} {
      allow read: if isCouple();
      allow write: if isCouple() && myKey() == owner;
    }

    // Yemek planı ve tarif defteri
    match /recipes/{id} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple() && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && request.resource.data.ingredients is list && request.resource.data.ingredients.size() <= 60;
    }
    match /meals/{date} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple() && request.resource.data.dishes is list && request.resource.data.dishes.size() <= 10;
    }

    // Özel günler (doğum günü, yıl dönümü…)
    match /specialDays/{id} {
      allow read, delete: if isCouple();
      allow create, update: if isCouple() && str(request.resource.data.title, 120) && request.resource.data.title.size() > 0
        && request.resource.data.date is string && request.resource.data.type in ['birthday', 'anniversary', 'other'];
    }

    // Diğer her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
